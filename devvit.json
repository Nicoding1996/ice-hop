{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "ice-hop",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "asUser": ["SUBSCRIBE_TO_SUBREDDIT", "SUBMIT_COMMENT"]
    }
  },
  "marketingAssets": {
    "icon": "brand/icon.png"
  },
  "menu": {
    "items": [
      {
        "label": "Post today's puzzle",
        "description": "Manually create the daily puzzle post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-daily"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-puzzle": {
        "endpoint": "/internal/scheduler/daily-puzzle",
        "cron": "0 12 * * *"
      },
      "endless-refill": {
        "endpoint": "/internal/scheduler/endless-refill",
        "cron": "*/5 * * * *"
      },
      "comment-leaderboards": {
        "endpoint": "/internal/scheduler/comment-leaderboards",
        "cron": "2,7,12,17,22,27,32,37,42,47,52,57 * * * *"
      },
      "daily-prepare": {
        "endpoint": "/internal/scheduler/daily-prepare",
        "cron": "4,14,24,34,44,54 * * * *"
      },
      "player-flair": {
        "endpoint": "/internal/scheduler/player-flair",
        "cron": "8,18,28,38,48,58 * * * *"
      }
    }
  },
  "settings": {
    "subreddit": {
      "playerFlair": {
        "type": "boolean",
        "label": "Player flair",
        "helpText": "Show each player's Daily streak, Dailies solved, and puzzles built as user flair. Ice Hop never replaces flair a player or moderator chose. Turning this off stops updates and leaves existing flair as it is.",
        "defaultValue": true
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "ice_hop_dev"
  }
}